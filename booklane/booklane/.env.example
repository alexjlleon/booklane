# Public URL of the app (no trailing slash). Used in emails, OAuth redirects and embed code.
BASE_URL=https://book.example.com
PORT=3000
# Long random string. Signs nothing in cookies but encrypts stored calendar tokens. Do not change after launch.
APP_SECRET=replace-with-64-random-characters
# Where the SQLite database lives. On Railway, mount a volume at /data.
DATA_DIR=/data
# Set to false to stop public sign ups after you create your account (invites still work).
ALLOW_SIGNUP=true
# Branding for the platform itself
APP_NAME=Booklane
# Redirect / to the first business page instead of the platform home
# HOME_REDIRECT=business
# Load the demo business (sample prices) once, on an empty database. Remove after the first deploy.
# SEED_DEMO=true
# SEED_EMAIL=you@yourdomain.com
# SEED_PASSWORD=choose-a-strong-one

# ---------------------------------------------------------------------------
# Provider keys (Stripe, Twilio, Resend)
#
# All of these can be entered in the app instead, under Settings -> Integrations,
# where they are encrypted with APP_SECRET. A value saved in the app wins over the
# one here, so these lines are only a fallback for a deploy that prefers Railway
# variables. Leaving them blank is normal.
# ---------------------------------------------------------------------------

# Email (https://resend.com). Without it, emails are only written to the Email log.
RESEND_API_KEY=
EMAIL_FROM=Bookings <bookings@yourdomain.com>

# Card payments for sellable sessions (https://dashboard.stripe.com/apikeys).
# Webhook endpoint: {BASE_URL}/webhooks/stripe   Events: checkout.session.completed
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Text messages (https://console.twilio.com). US/Canada sending needs 10DLC
# registration first, or carriers drop the messages.
# Inbound webhook (for STOP replies): {BASE_URL}/webhooks/twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
# Use a Messaging Service instead of a single number, if you have one.
TWILIO_MESSAGING_SERVICE_SID=

# The window texts may be sent in, in the recipient's own timezone, so nobody is
# woken up by a reminder. Anything due outside it waits. Defaults shown.
# SMS_QUIET_START_HOUR=8
# SMS_QUIET_END_HOUR=21

# How often the scheduled-message worker wakes up. Default 60000 (one minute).
# JOB_INTERVAL_MS=60000

# Google Calendar (console.cloud.google.com -> APIs & Services -> Credentials -> OAuth client, type Web)
# Authorized redirect URI: {BASE_URL}/oauth/google/callback   Enable: Google Calendar API
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Outlook / Microsoft 365 (portal.azure.com -> App registrations -> New, Web platform)
# Redirect URI: {BASE_URL}/oauth/microsoft/callback   API permissions: Calendars.ReadWrite, User.Read, offline_access
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
MICROSOFT_TENANT=common

# Only for local development: allow webhooks/BoothBook URLs on http:// or private networks
# ALLOW_PRIVATE_URLS=true
